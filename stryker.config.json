{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "jest": { "projectType": "custom", "configFile": "test/helpers/jest.stryker.config.js", "enableFindRelatedTests": false },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "inPlace": false,
  "disableTypeChecks": false,
  "incremental": true,
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["/android", "/ios", "/e2e-output", "/harness", "/harness-local", "/qa", "/eval", "/coverage", "/.stryker-tmp", "/graphify-out"],
  "reporters": ["clear-text", "progress", "json", "html"],
  "htmlReporter": { "fileName": "coverage/mutation/index.html" },
  "jsonReporter": { "fileName": "coverage/mutation/mutation.json" },
  "mutate": []
}
