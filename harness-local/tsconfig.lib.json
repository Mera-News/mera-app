{
  "//": [
    "Scoped typecheck for the harness-local runner libraries.",
    "tsconfig.json pulls in ../lib/news-harness and, through it, app modules where",
    "~1,700 errors pre-exist, so `tsc -p harness-local/tsconfig.json` cannot tell a",
    "new mistake from the standing red. This file lists ONLY the runner libraries",
    "and their own imports, so its exit code means something.",
    "  npx tsc -p harness-local/tsconfig.lib.json"
  ],
  "compilerOptions": {
    "noEmit": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "files": [
    "lib/staging-guard.ts",
    "lib/jsonl-writer.ts",
    "lib/model-catalog.ts",
    "lib/agreement.ts",
    "lib/run-writer.ts",
    "lib/near-call.ts",
    "lib/cost-estimate.ts",
    "lib/corpus.ts",
    "lib/chat-turn.ts",
    "config/env.ts",
    "config/local-data.ts",
    "adapters/auth.ts",
    "adapters/gateway-e2ee-llm.ts",
    "scripts/selftest.ts",
    "scripts/replay-persona-chat.ts",
    "scripts/run-newsharness-corpus.ts",
    "scripts/run-persona-corpus.ts",
    "scripts/run-topicgen-corpus.ts",
    "scripts/fetch-staging-fixture.ts",
    "scripts/rater-export.ts",
    "scripts/rater-agreement.ts",
    "scripts/rater-decode.ts",
    "scripts/probe-gateway.ts",
    "scripts/extraction-metrics.ts"
  ]
}
