{
  "name": "mera-app",
  "main": "index.js",
  "version": "1.3.8",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "skills:generate": "tsx lib/mera-harness/skills/generate.ts",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "check:animations": "python3 scripts/animations/validate.py assets/animations",
    "check:schema": "node scripts/check-schema.js",
    "update:development": "node scripts/ota-publish.js --channel development --environment development --",
    "update:preview": "node scripts/ota-publish.js --channel preview --environment preview --",
    "update:production": "node scripts/ota-publish.js --channel production --environment production --",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test-news-harness-persona-management": "tsx --tsconfig harness-local/tsconfig.json harness-local/scripts/test-news-harness-persona-management.ts",
    "test-news-harness-article-pipeline": "tsx --tsconfig harness-local/tsconfig.json harness-local/scripts/test-news-harness-article-pipeline.ts",
    "harness:compare": "tsx --tsconfig harness-local/tsconfig.json harness-local/scripts/compare-runs.ts",
    "eval:golden": "node eval/eval-golden.js",
    "eval:grouping": "npx tsx eval/sanity-grouping.ts",
    "test:legacy": "jest --selectProjects legacy --maxWorkers=2",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --maxWorkers=2",
    "test:mock-backend": "tsx --test test/mock-backend/*.node-test.ts",
    "test:full": "H=../bin/heavy; [ -x \"$H\" ] || H=; ${H:+$H --all} npx jest --maxWorkers=2 && npm run test:mock-backend && bash scripts/e2e-android.sh",
    "e2e:android": "bash scripts/e2e-android.sh",
    "mock-backend": "tsx test/mock-backend/server.ts",
    "mutate": "stryker run",
    "stryker:chat": "stryker run --incrementalFile coverage/mutation/chat.incremental.json --mutate \"lib/e2ee/**/*.ts,!lib/e2ee/__tests__/**,lib/llm/cloudComplete.ts,lib/hooks/useCloudPersonaChat.ts\"",
    "stryker:persona": "stryker run --incrementalFile coverage/mutation/persona.incremental.json --mutate \"lib/billing-service.ts,lib/subscription/**/*.ts,lib/security/**/*.ts,lib/services/scoring-pipeline.ts,!**/__tests__/**\"",
    "stryker:data": "stryker run --incrementalFile coverage/mutation/data.incremental.json --mutate \"lib/scheduler/feed-sync/**/*.ts,lib/database/services/article-suggestion-mappers.ts,lib/database/services/article-suggestion-reads.ts,lib/database/services/article-suggestion-scoring-writes.ts,lib/database/services/article-suggestion-persist.ts,lib/database/services/article-suggestion-lifecycle.ts,lib/database/services/article-suggestion-diagnostics.ts,!**/__tests__/**\""
  },
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@better-auth/expo": "~1.6.33",
    "@cospired/i18n-iso-languages": "^4.2.0",
    "@dr.pogodin/react-native-fs": "^2.41.0",
    "@expo/html-elements": "~58.0.3",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@gluestack-ui/core": "~3.0.25",
    "@gluestack-ui/utils": "~3.0.21",
    "@intercom/intercom-react-native": "10.9.0",
    "@legendapp/motion": "^2.5.3",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "16.2.0",
    "@sentry/react-native": "~8.33.0",
    "better-auth": "~1.6.33",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-background-task": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
