    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "expo-translate-text": "^0.3.0",
    "expo-updates": "~58.0.20",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "graphql": "^16.11.0",
    "http-status-codes": "^2.3.0",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.5.12",
    "llama.rn": "0.13.0-rc.9",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^1.66.0",
    "nativewind": "4.2.7",
    "pako": "^3.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-cloud-storage": "3.3.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~2.1.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "~10.16.0",
    "react-native-purchases-ui": "~10.16.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-variants": "^0.1.20",
    "tailwindcss": "~3.4.19",
    "tslib": "^2.9.1",
    "validator": "^13.15.35",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@expo/cli": "^58.1.18",
    "@expo/ngrok": "^4.1.3",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@react-native/jest-preset": "^0.88.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/validator": "^13.15.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "msw": "2.15.0",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson"
        ]
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
