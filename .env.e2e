# e2e build only (scripts/e2e-android.sh). Loopback mock backend. No Sentry,
# RevenueCat, Intercom, Google or device-attest keys, by design.
EXPO_PUBLIC_E2E=1
EXPO_PUBLIC_GRAPHQL_SERVER_ENDPOINT=http://10.0.2.2:8790
EXPO_PUBLIC_AUTH_ENDPOINT=http://10.0.2.2:8790
EXPO_PUBLIC_INFERENCE_ENDPOINT=http://10.0.2.2:8790
